# ─── Networking & Project ──────────────────────────────────────────
ATS_PROJECT_NAME=ats
SERVER_IP=192.168.100.5

# --- Integracion Portal Publico ---
PORTAL_SERVER_IP=192.168.100.5
PORTAL_DEV_PORT=8088
PORTAL_NGINX_PORT=81
PORTAL_NGINX_HTTPS_PORT=444

# Puertos Únicos (Iguales para Interno y Externo)
DB_PORT=5433
REDIS_PORT=6380
APP_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# --- Vite / API ---
VITE_API_PORT=${APP_PORT}
VITE_API_BASE_URL=/api
VITE_PUBLIC_PORTAL_URL_DEV=http://${PORTAL_SERVER_IP}:${PORTAL_DEV_PORT}
VITE_PUBLIC_PORTAL_URL_PROD=https://${PORTAL_SERVER_IP}:${PORTAL_NGINX_HTTPS_PORT}

# ─── Frontend URL for password reset links ---
FRONTEND_URL=http://${SERVER_IP}:${FRONTEND_PORT}

# ─── Django Settings ───────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-real-one-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,${SERVER_IP},0.0.0.0

# ─── Database ──────────────────────────────────────────────────────
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE
DB_HOST=db

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ─── Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2
CELERY_CONCURRENCY=4

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT},http://127.0.0.1:${FRONTEND_PORT},http://${SERVER_IP}:${FRONTEND_PORT},http://${PORTAL_SERVER_IP}:${PORTAL_DEV_PORT},http://127.0.0.1:${PORTAL_DEV_PORT},http://${SERVER_IP}:${PORTAL_DEV_PORT},http://${PORTAL_SERVER_IP}:${PORTAL_NGINX_PORT},http://${SERVER_IP}:${PORTAL_NGINX_PORT},https://${PORTAL_SERVER_IP}:${PORTAL_NGINX_HTTPS_PORT},https://${SERVER_IP}:${PORTAL_NGINX_HTTPS_PORT}

# ─── Docker Build Args ─────────────────────────────────────────────
PYTHON_VERSION=3.12-slim
APP_DIR=/app
APP_HOST=0.0.0.0
GUNICORN_WORKERS=4
DJANGO_WSGI=config.wsgi

# ─── SMTP & Webmail Configuration ──────────────────────────────────
LOCAL_MAIL_DOMAIN=ats.local
POSTFIX_USE_RELAY=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
IMAP_PORT=143
WEBMAIL_ROUTE=/webmail
WEBMAIL_PORT=80

# ─── Storage Configuration (Supabase S3-compatible) ────────────
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=user-files
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
STORAGE_REGION=us-east-1
MAX_UPLOAD_SIZE=52428800
USER_STORAGE_QUOTA=1073741824
