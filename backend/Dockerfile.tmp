# ─────────────────────────────────────────────────────────────────────────────
# Todas las variables vienen del .env via docker-compose (ARG + build.args)
# No hay valores hardcodeados en este archivo.
# ─────────────────────────────────────────────────────────────────────────────

# Build-time args — sin defaults: DEBEN venir del .env vía docker-compose
ARG PYTHON_VERSION
ARG APP_DIR
ARG APP_HOST
ARG APP_PORT

FROM python:${PYTHON_VERSION}

# Re-declarar ARGs después del FROM (scope de Docker)
ARG APP_DIR
ARG APP_HOST
ARG APP_PORT
ARG GUNICORN_WORKERS
ARG DJANGO_WSGI

# Convertir ARGs de build a ENVs de runtime
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV APP_DIR=${APP_DIR}
ENV APP_HOST=${APP_HOST}
ENV APP_PORT=${APP_PORT}
ENV GUNICORN_WORKERS=${GUNICORN_WORKERS}
ENV DJANGO_WSGI=${DJANGO_WSGI}

WORKDIR ${APP_DIR}

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ${APP_DIR}/
RUN pip install --no-cache-dir -r requirements.txt

COPY . ${APP_DIR}/

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE ${APP_PORT}

ENTRYPOINT ["/entrypoint.sh"]

# Comando por defecto (sobreescrito en docker-compose para dev)
CMD ["sh", "-c", "gunicorn ${DJANGO_WSGI} --bind ${APP_HOST}:${APP_PORT} --workers ${GUNICORN_WORKERS}"]
