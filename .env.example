# ─── Networking & Project ────────────────────────────────────────────────────
ATS_PROJECT_NAME=ats
PORTAL_PROJECT_NAME=portapublico
SERVER_IP=192.168.100.5

# ─── Configuración de Conexión al ATS (Portal) ──────────────────────────────
ATS_SERVER_IP=192.168.100.5
ATS_APP_PORT=8000
PORTAL_SERVER_IP=192.168.100.5

# ─── Puertos ATS ─────────────────────────────────────────────────────────────
DB_PORT=5433
REDIS_PORT=6380
APP_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# ─── Puertos Locales de portaPublico ─────────────────────────────────────────
PORTAL_DEV_PORT=8088
PORTAL_NGINX_PORT=81
PORTAL_NGINX_HTTPS_PORT=444

# ─── Vite / API (ATS) ────────────────────────────────────────────────────────
VITE_API_PORT=8000
VITE_API_BASE_URL=/api
VITE_PUBLIC_PORTAL_URL_DEV=http://${PORTAL_SERVER_IP}:${PORTAL_DEV_PORT}
VITE_PUBLIC_PORTAL_URL_PROD=https://${PORTAL_SERVER_IP}:${PORTAL_NGINX_HTTPS_PORT}

# ─── Frontend URL for password reset links ---
FRONTEND_URL=http://${SERVER_IP}:${FRONTEND_PORT}

# ─── Vite / API (Portal) ─────────────────────────────────────────────────────
# URL de Producción (Se usa para el build final)
VITE_PORTAL_API_BASE_URL=https://${PORTAL_SERVER_IP}/api
# URL de Desarrollo (Se construye dinámicamente)
VITE_PORTAL_API_BASE_URL_DEV=http://${ATS_SERVER_IP}:${ATS_APP_PORT}/api

# ─── Django Settings (ATS) ───────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-real-one-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,${SERVER_IP},0.0.0.0,backend

# ─── Database (ATS) ──────────────────────────────────────────────────────────
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db

# ─── Redis (ATS) ─────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ─── Celery (ATS) ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2
CELERY_CONCURRENCY=4

# ─── CORS ────────────────────────────────────────────────────────────────────
# Combinación de ATS y PortaPublico
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT},http://127.0.0.1:${FRONTEND_PORT},http://${SERVER_IP}:${FRONTEND_PORT},http://localhost:${PORTAL_DEV_PORT},http://127.0.0.1:${PORTAL_DEV_PORT},http://${SERVER_IP}:${PORTAL_DEV_PORT},http://localhost:${PORTAL_NGINX_PORT},http://${SERVER_IP}:${PORTAL_NGINX_PORT},https://localhost:${PORTAL_NGINX_HTTPS_PORT},https://${SERVER_IP}:${PORTAL_NGINX_HTTPS_PORT}

# ─── Docker Build Args (ATS) ─────────────────────────────────────────────────
PYTHON_VERSION=3.12-slim
APP_DIR=/app
APP_HOST=0.0.0.0
GUNICORN_WORKERS=4
DJANGO_WSGI=config.wsgi

# ─── SMTP Configuration (envío automático de correos) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password-de-google
DEFAULT_FROM_EMAIL=tu-correo@gmail.com
